# Database (PostgreSQL)
# Local development:
DATABASE_URL="postgresql://postgres:123@localhost:5432/saa?schema=public"
# Docker Compose environment:
# DATABASE_URL="postgresql://postgres:postgres123@saa-db:5432/saa?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=saa

# Application
PORT=3000
NODE_ENV=production
DEFAULT_TIMEZONE=Asia/Jakarta

# Firebase Auth Configuration
# Set to 'true' untuk mode development bypass dengan 'dev-token'
FIREBASE_DEV_BYPASS=true
# FIREBASE_PROJECT_ID=smart-academic-assistant
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@smart-academic-assistant.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
